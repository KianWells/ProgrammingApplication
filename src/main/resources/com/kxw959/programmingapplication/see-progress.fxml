<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<TilePane alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kxw959.programmingapplication.controllers.SeeProgressController">
   <children>
      <HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" TilePane.alignment="CENTER">
         <children>
            <ScrollPane hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <content>
                  <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="680.0" prefWidth="1025.0" spacing="20.0">
                     <children>
                        <MenuButton fx:id="classMenu" mnemonicParsing="false" text="Choose Class" />
                        <Accordion fx:id="studentAccordian" VBox.vgrow="ALWAYS">
                  </Accordion>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <bottom>
                  <Button mnemonicParsing="false" onAction="#onClickBack" prefHeight="25.0" prefWidth="104.0" text="Back" BorderPane.alignment="TOP_RIGHT" />
               </bottom>
            </BorderPane>
         </children>
         <TilePane.margin>
            <Insets />
         </TilePane.margin>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </children>
</TilePane>
