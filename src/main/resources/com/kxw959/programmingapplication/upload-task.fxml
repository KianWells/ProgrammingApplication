<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kxw959.programmingapplication.controllers.UploadTasksController">
   <children>
      <Text layoutX="14.0" layoutY="39.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Choose a  folder to upload">
         <font>
            <Font size="23.0" />
         </font>
      </Text>
      <Button fx:id="browseButton" layoutX="14.0" layoutY="67.0" mnemonicParsing="false" onAction="#onClickBrowse" text="Browse" />
      <Button fx:id="uploadButton" layoutX="150.0" layoutY="67.0" mnemonicParsing="false" onAction="#onClickUpload" text="Upload" />
      <ListView fx:id="taskList" layoutX="14.0" layoutY="107.0" prefHeight="274.0" prefWidth="346.0" />
      <TableView fx:id="classTable" layoutX="386.0" layoutY="14.0" prefHeight="369.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="classColumn" prefWidth="135.0" text="Class" />
          <TableColumn fx:id="selectColumn" prefWidth="64.0" text="Select" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
