<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<TilePane alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/1.8.0_311" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kxw959.programmingapplication.controllers.RegisterStudentsController">
   <children>
      <HBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" TilePane.alignment="CENTER">
         <children>
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" prefWidth="695.0" spacing="20.0">
               <children>
                  <VBox spacing="20.0">
                     <children>
                        <Label text="Student Name" />
                        <TextField fx:id="nameText" maxWidth="-Infinity" prefHeight="25.0" prefWidth="247.0">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </TextField>
                     </children>
                  </VBox>
                  <Button fx:id="registerIndividual" mnemonicParsing="false" onAction="#onClickIndividual" prefHeight="25.0" prefWidth="189.0" text="Register Individual Student">
                     <VBox.margin>
                        <Insets bottom="40.0" />
                     </VBox.margin>
                  </Button>
                  <Label prefHeight="60.0" prefWidth="278.0" text="Multiple students can be registered at once by uploading a .csv file containing all of the students' names seperated by commas." wrapText="true" />
                  <Button fx:id="registerCSV" mnemonicParsing="false" onAction="#onClickCSV" prefHeight="25.0" prefWidth="189.0" text="Register Students by .csv">
                     <VBox.margin>
                        <Insets bottom="40.0" />
                     </VBox.margin>
                  </Button>
                  <Label text="Select the class you want and click the button below to download a .pdf file with students' login details." wrapText="true" />
                  <Button fx:id="getPDF" mnemonicParsing="false" onAction="#onClickPDF" prefHeight="25.0" prefWidth="189.0" text="Get .pdf of Student Login Details" />
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
            <Pane prefHeight="539.0" prefWidth="58.0" />
            <VBox prefHeight="720.0" prefWidth="494.0" spacing="20.0">
               <children>
                  <ListView fx:id="classList" onMouseClicked="#onClickItem" prefHeight="361.0" prefWidth="295.0" />
                  <VBox spacing="20.0">
                     <children>
                        <Label text="Class Name" />
                        <TextField fx:id="className" maxWidth="-Infinity" prefHeight="25.0" prefWidth="215.0" />
                     </children>
                  </VBox>
                  <Button fx:id="addClass" mnemonicParsing="false" onAction="#onClickAddClass" text="Add New Class" />
                  <AnchorPane>
                     <children>
                        <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onClickBack" prefHeight="25.0" prefWidth="50.0" text="Back" textAlignment="CENTER" AnchorPane.rightAnchor="0.0" />
                     </children>
                  </AnchorPane>
               </children>
            </VBox>
         </children>
         <TilePane.margin>
            <Insets />
         </TilePane.margin>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </children>
</TilePane>
