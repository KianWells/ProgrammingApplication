<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kxw959.programmingapplication.controllers.UploadTasksController">
   <children>
      <Pane fx:id="namePane" layoutX="26.0" layoutY="21.0" prefHeight="359.0" prefWidth="548.0">
         <children>
            <Label layoutX="34.0" layoutY="35.0" text="Enter a name for the new task">
               <font>
                  <Font name="Arial" size="36.0" />
               </font>
            </Label>
            <TextField fx:id="nameField" layoutX="200.0" layoutY="116.0" />
            <Button layoutX="245.0" layoutY="167.0" mnemonicParsing="false" onAction="#onClickConfirmName" text="Confirm" />
         </children>
      </Pane>
      <Pane fx:id="typePane" layoutX="26.0" layoutY="21.0" prefHeight="359.0" prefWidth="548.0" visible="false">
         <children>
            <Label layoutX="115.0" layoutY="35.0" text="Choose type of task">
               <font>
                  <Font name="Arial" size="36.0" />
               </font>
            </Label>
            <Button layoutX="254.0" layoutY="167.0" mnemonicParsing="false" onAction="#onClickConfirmQuiz" text="Quiz" />
            <Button layoutX="77.0" layoutY="167.0" mnemonicParsing="false" onAction="#onClickConfirmProgrammingTask" text="Programming Task" />
            <Button layoutX="352.0" layoutY="167.0" mnemonicParsing="false" onAction="#onClickConfirmBoth" text="Both/Hybrid" />
         </children>
      </Pane>
      <Pane fx:id="filePane" layoutX="26.0" layoutY="21.0" prefHeight="359.0" prefWidth="548.0" visible="false">
         <children>
            <Label layoutX="169.0" layoutY="35.0" text="Choose Files">
               <font>
                  <Font name="Arial" size="36.0" />
               </font>
            </Label>
            <Label fx:id="infoLabel" alignment="TOP_LEFT" layoutX="274.0" layoutY="94.0" prefHeight="121.0" prefWidth="258.0" text="Label" />
            <ListView fx:id="taskList" layoutX="14.0" layoutY="94.0" prefHeight="251.0" prefWidth="243.0" />
            <Button layoutX="274.0" layoutY="320.0" mnemonicParsing="false" onAction="#onClickBrowse" text="Browse" />
            <Button layoutX="350.0" layoutY="320.0" mnemonicParsing="false" onAction="#onClickDelete" text="Delete Selected" />
            <Button layoutX="467.0" layoutY="320.0" mnemonicParsing="false" onAction="#onClickContinue" text="Continue" />
            <Label fx:id="errorLabel" alignment="TOP_LEFT" layoutX="274.0" layoutY="246.0" prefHeight="50.0" prefWidth="258.0" text="Label" />
         </children>
      </Pane>
      <Pane fx:id="classPane" layoutX="26.0" layoutY="21.0" prefHeight="359.0" prefWidth="548.0" visible="false">
         <children>
            <Label layoutX="62.0" layoutY="35.0" text="Select classes to assign to">
               <font>
                  <Font name="Arial" size="36.0" />
               </font>
            </Label>
            <ListView fx:id="classList" layoutX="174.0" layoutY="101.0" prefHeight="200.0" prefWidth="200.0" />
            <Button layoutX="469.0" layoutY="320.0" mnemonicParsing="false" onAction="#onClickFinish" text="Continue" />
         </children>
      </Pane>
   </children>
</AnchorPane>
